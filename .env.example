# The cTrader remote MCP slug for the *trading* profile.
# Generate in cTrader Web -> Settings -> Remote MCP.
#
# This is the one credential your agent must NOT have. Preflight holds it so the
# agent can't reach the broker except through the gate. If you also bind the
# trading profile in your MCP client config, Preflight is bypassed entirely.
PREFLIGHT_CTRADER_SLUG=

# Which cTrader remote MCP endpoint Preflight forwards to.
PREFLIGHT_CTRADER_URL=https://mcp.ctrader.com/trading/mcp

# observe = evaluate, journal, and forward anyway (records what it WOULD have blocked)
# enforce = a DENY stops the order
PREFLIGHT_MODE=observe
